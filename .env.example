# Postgres connection string — from Vercel: Storage tab → your database → .env.local tab
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# https://resend.com → API Keys
RESEND_API_KEY=

# Optional: defaults to the Resend sandbox sender until a domain is verified
# EMAIL_FROM="DevisImmo <devis@tondomaine.fr>"

# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Created by scripts/setup-stripe-price.ts — see console output after running it
STRIPE_PRICE_ID=

# https://dashboard.stripe.com/test/webhooks — only needed once deployed
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe redirect URLs; update at deployment
NEXT_PUBLIC_APP_URL=http://localhost:3000
